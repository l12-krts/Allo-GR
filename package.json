{
  "name": "allo-gr",
  "version": "1.1.0",
  "description": "Allo with Greek: the friendly variable typeface (optical size, weight, roundness) plus a full monotonic Greek, as web fonts, CSS, a Tailwind v4 theme and a React component.",
  "keywords": [
    "font",
    "typeface",
    "variable font",
    "woff2",
    "sans-serif",
    "greek",
    "allo",
    "react",
    "tailwind"
  ],
  "license": "OFL-1.1",
  "author": "Josh Puckett (https://joshpuckett.me); Greek: L12-MC",
  "type": "module",
  "files": [
    "allo.css",
    "allo-friendly.css",
    "tailwind.css",
    "react/index.js",
    "react/index.d.ts",
    "fonts/webfonts/AlloVariable.woff2",
    "fonts/webfonts/AlloVariableFriendly.woff2",
    "fonts/webfonts/Allo-ThinOblique.woff2",
    "fonts/webfonts/Allo-ExtraLightOblique.woff2",
    "fonts/webfonts/Allo-LightOblique.woff2",
    "fonts/webfonts/Allo-Oblique.woff2",
    "fonts/webfonts/Allo-MediumOblique.woff2",
    "fonts/webfonts/Allo-SemiBoldOblique.woff2",
    "fonts/webfonts/Allo-BoldOblique.woff2",
    "fonts/webfonts/Allo-ExtraBoldOblique.woff2",
    "fonts/webfonts/Allo-BlackOblique.woff2",
    "OFL.txt"
  ],
  "style": "allo.css",
  "main": "allo.css",
  "exports": {
    ".": "./allo.css",
    "./allo.css": "./allo.css",
    "./friendly": "./allo-friendly.css",
    "./allo-friendly.css": "./allo-friendly.css",
    "./tailwind.css": "./tailwind.css",
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ]
}
